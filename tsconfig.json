{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2022",
    "types": ["node"],
    "rootDir": ".",
    "outDir": "./dist",
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true
  },
  "include": [
    "src/**/*.ts",
    "controllers/**/*.ts",
    "data/**/*.ts",
    "menus/**/*.ts",
    "models/**/*.ts",
    "repositories/**/*.ts",
    "services/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
